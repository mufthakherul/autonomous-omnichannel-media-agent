# Gemini API Key (Required for AI Video Inspection, SEO Metadata & Smart Comment Replies)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Default: gemini-3.8-flash for fast agentic video understanding & structured output)
GEMINI_MODEL=gemini-3.8-flash

# YouTube OAuth 2.0 Configuration
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=data/youtube_token.json
# Set YOUTUBE_SIMULATION_MODE=true to test the full pipeline without live YouTube uploads
YOUTUBE_SIMULATION_MODE=true

# Optional Stock Video & Cloud Source Credentials
PEXELS_API_KEY=
PIXABAY_API_KEY=
TELEGRAM_BOT_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Agent Automation Defaults
AGENT_AUTO_LOOP_ENABLED=false
AGENT_LOOP_INTERVAL_SECONDS=300
AUTO_REMEDIATE_FAILED_VIDEOS=true
PRECHECK_PRIVACY_STATUS=private
DAILY_UPLOAD_LIMIT=4
UPLOAD_SPACING_HOURS=4
AUTO_REPLY_COMMENTS=false
CHANNEL_PERSONA=Friendly, knowledgeable, and concise creator who appreciates viewers and answers questions clearly without fluff.
